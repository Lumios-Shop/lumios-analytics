# Port du serveur backend
PORT=3001

# --- CONFIGURATION SHOPIFY ADMIN API ---
# Nom de votre boutique Shopify (ex: ma-boutique.myshopify.com)
SHOPIFY_SHOP_NAME=
# Access Token de votre application personnalisée Shopify
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# --- CONFIGURATION AMAZON SELLER CENTRAL SP-API ---
# Identifiants de l'application de vente (LWA)
SELLER_CENTRAL_CLIENT_ID=
# Secret de l'application de vente (LWA)
SELLER_CENTRAL_CLIENT_SECRET=
# Refresh Token obtenu après autorisation du vendeur
SELLER_CENTRAL_REFRESH_TOKEN=
# ID de la marketplace Amazon (ex: A13V1IB3VIYZZH pour Amazon France)
SELLER_CENTRAL_MARKETPLACE_ID=A13V1IB3VIYZZH
